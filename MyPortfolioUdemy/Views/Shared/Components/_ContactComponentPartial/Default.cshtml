@model List<MyPortfolioUdemy.DAL.Entities.Contact>

<section id="contact" class="s-contact target-section"
         style="background-image: url('@Url.Content("~/Cv/wallhaven-3qrdr6.jpg")') !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;">
    <div class="overlay"></div>
  

    @foreach (var item in Model)
    {
        <div class="row narrow section-intro">
            <div class="col-full">

                <h3>İLETİŞİM</h3>
                <h1>@item.Title</h1>

                <p class="lead">
                    @item.Description
                </p>

            </div>
        </div>

        <div class="row contact__main">

            <div class="col-eight tab-full contact__form">

                <form name="contactForm"
                      id="contactForm"
                      method="post"
                      action="">

                    <fieldset>

                        <div class="form-field">
                            <input name="contactName"
                                   type="text"
                                   id="contactName"
                                   placeholder="Adınız Soyadınız"
                                   minlength="2"
                                   required
                                   class="full-width">
                        </div>

                        <div class="form-field">
                            <input name="contactEmail"
                                   type="text"
                                   id="contactEmail"
                                   placeholder="E-posta Adresiniz"
                                   required
                                   class="full-width">
                        </div>

                        <div class="form-field">
                            <input name="contactSubject"
                                   type="text"
                                   id="contactSubject"
                                   placeholder="Konu"
                                   class="full-width">
                        </div>

                        <div class="form-field">
                            <textarea name="contactMessage"
                                      id="contactMessage"
                                      placeholder="Mesajınızı yazınız..."
                                      rows="10"
                                      cols="50"
                                      required
                                      class="full-width"></textarea>
                        </div>

                      @*   <div class="form-field">
                            <button type="submit"
                                    class="full-width btn--primary">
                                MESAJ GÖNDER
                            </button>
                        </div> *@
                        <button type="submit"
                                class="full-width btn--primary"
                                style="background-color: #2196F3 !important;
                            border-color: #2196F3 !important;
                            color: #FFFFFF !important;">
                            MESAJ GÖNDER
                        </button>
                    </fieldset>
                </form>

            </div>

            <div class="col-four tab-full contact__infos">

                <h4 class="h06">TELEFON</h4>

                <p>
                    @item.Phone1

                    @if (!string.IsNullOrWhiteSpace(item.Phone2))
                    {
                        <br />
                        @item.Phone2
                    }
                </p>

                <h4 class="h06">E-POSTA</h4>

                <p>
                    @item.Email1

                    @if (!string.IsNullOrWhiteSpace(item.Email2))
                    {
                        <br />
                        @item.Email2
                    }
                </p>

                <h4 class="h06">ADRES</h4>

                <p>@item.Address</p>

            </div>

        </div>
    }

</section>
