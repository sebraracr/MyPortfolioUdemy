@model List<MyPortfolioUdemy.DAL.Entities.Skill>

@{
    int x = 0;
    string bar = "progress percent";
}
<div class="col-six tab-full right">
    <h3>Yeteneklerim</h3>
    <ul class="skill-bars">
        @foreach (var item in Model)
        {
            x= item.Value - item.Value % 5;
            bar = "progress percent" +x;
            <li>
                <div class="@bar"><span>@item.Value %</span></div>
                <strong>@item.Title</strong>
            </li>
        }
    </ul>
</div>