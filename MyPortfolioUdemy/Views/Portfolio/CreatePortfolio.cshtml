@model Portfolio
@{
	ViewData["Title"] = "CreatePortfolio";
	Layout = "/Views/Layout/Index.cshtml";
}
<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Portfolyo</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Portfolyo Ekleme Sayfası</div>
					</div>
					<div class="card-body">

						<form method="post">
							<label>Proje Adı</label>
							<input type="text" asp-for="Title" class="form-control" />
							<br />
							<label>Çalışılan Programlama Dili</label>
							<input type="text" asp-for="SubTitle" class="form-control" />
							<br />
							<label>Image Url</label>
							<input type="text" asp-for="ImageUrl" class="form-control" />
							<br />
							<label>Proje Linki</label>
							<input type="text" asp-for="Url" class="form-control" />
							<br />
							<label>Açıklama</label>
							<textarea rows="4" class="form-control" asp-for="Description"></textarea>
							<br />
							<button class="btn btn-primary">Portfolyo Ekle</button>
						</form>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>

